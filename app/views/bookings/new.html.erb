  <%= image_tag "page_logo.png", alt: "Flight Booker logo", class: "page_logo" %>

<div class="booking_form">
  <h1 class="page_title">Complete Your Booking</h1>

  <p>
    <strong>Passengers:</strong> <%= @passengers_count %><br>
    <strong>From:</strong> <%= @flight.departure_airport.code %><br>
    <strong>To:</strong> <%= @flight.arrival_airport.code %><br>
    <strong>Depart:</strong> <%= @flight.start_datetime.strftime("%b %d • %H:%M") %><br>
    <strong>Duration:</strong> <%= @flight.duration_minutes/60 %>h <%= @flight.duration_minutes%60 %>min<br>
  </p>

  <% if @booking.errors.any? %>
  <div class="errors">
    <ul>
      <% @booking.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

  <%= form_with model: @booking, data: { turbo: false } do |f| %>
    <%= f.hidden_field :flight_id %>

    <%= f.fields_for :passengers do |p| %>
      <div class="passenger">
        <%= p.label :name, "Name" %>
        <%= p.text_field :name %>      
      </div>
    <% end %>
    <div class="submit">
      <%= f.submit "Create Booking" %>
    </div>
  <% end %>

</div>